# Copy to .env next to compose.yaml, then: docker compose up -d
# Signs operator sessions. 24+ random characters, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FOXPROFILE_API_TOKEN=
# Password of the `admin` user, created on first start (change it later from the panel).
FOXPROFILE_ADMIN_PASSWORD=
# Port the hub is published on (default 8000).
# FOXPROFILE_HUB_PORT=8000
# Language of server error messages and of the agents on every PC: en, vi or es.
# The web panel starts in Spanish; each user can change it in Settings > General.
FOXPROFILE_LANG=es
