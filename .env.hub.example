# Copy to .env next to compose.yaml, then: docker compose up -d
# Signs operator sessions. 24+ random characters, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FOXPROFILE_API_TOKEN=
# Password of the `admin` user, created on first start (change it later from the panel).
FOXPROFILE_ADMIN_PASSWORD=
# Port the hub is published on (default 8000).
# FOXPROFILE_HUB_PORT=8000
# Language of server error messages and of the agents on every PC: en, vi or es.
# The web panel starts in Spanish; each user can change it in Settings > General.
FOXPROFILE_LANG=es
# Optional: keep the agent installers (Settings > Agents) in a private S3 bucket
# such as RustFS instead of ./data/installers. The hub hands out presigned URLs.
# FOXPROFILE_S3_ENDPOINT=http://rustfs:9000
# Address browsers use for the bucket, if not the same as FOXPROFILE_S3_ENDPOINT.
# FOXPROFILE_S3_PUBLIC_URL=https://files.example.com
# FOXPROFILE_S3_BUCKET=foxprofile
# FOXPROFILE_S3_ACCESS_KEY=
# FOXPROFILE_S3_SECRET_KEY=
# FOXPROFILE_S3_REGION=us-east-1
# Shared bucket: FoxProfile keeps to fox-profiles/<dev|prod>/installers/ (default prod).
# FOXPROFILE_S3_ENV=prod
